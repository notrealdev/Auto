{
	"version": "2.0.0",
	"options": {
		"shell": {
			"executable": "powershell.exe",
			"args": ["-NoProfile", "-Command"]
		}
	},
	"tasks": [
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/Auto.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "publish",
			"command": "dotnet",
			"type": "process",
			"args": [
				"publish",
				"${workspaceFolder}/Auto.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "watch",
			"command": "dotnet",
			"type": "process",
			"args": [
				"watch",
				"run",
				"--project",
				"${workspaceFolder}/Auto.csproj"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Auto release",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy", "Bypass",
				"-File", "${workspaceFolder}\\Build-Release.ps1"
			],
			"options": { "cwd": "D:\\G\\Auto" },
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Auto beta",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy", "Bypass",
				"-File", "${workspaceFolder}\\Build-Release.ps1",
				"-Beta"
			],
			"options": { "cwd": "D:\\G\\Auto" },
			"problemMatcher": [],
			"group": "build"
		}
	]
}