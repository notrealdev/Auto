<UserControl
	x:Class="Auto.UI.Views.MarketView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Auto.UI.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:Auto.UI.ViewModels"
	d:DataContext="{d:DesignInstance Type=vm:MarketViewModel}"
	mc:Ignorable="d">

	<Border Style="{StaticResource CardBorder}">
		<StackPanel>
			<CheckBox Margin="0,0,0,10" Content="Tự Rao" IsChecked="{Binding AutoAdvertise}" />

			<Grid Margin="0,0,0,10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<ComboBox
					Grid.Column="0"
					Margin="0,0,6,0"
					ItemsSource="{x:Static vm:MarketViewModel.Templates}"
					SelectedItem="{Binding SelectedTemplate}" />
				<Button Grid.Column="1" Padding="10,4" Command="{Binding InsertTemplateCommand}" Content="Chèn" />
			</Grid>

			<TextBox
				Height="72"
				Margin="0,0,0,10"
				Padding="3,3"
				AcceptsReturn="True"
				MaxLength="180"
				Style="{StaticResource NumericTextBox}"
				Text="{Binding AdvertiseText, UpdateSourceTrigger=PropertyChanged}"
				TextAlignment="Left"
				TextWrapping="Wrap"
				VerticalContentAlignment="Top"
				VerticalScrollBarVisibility="Auto" />

			<Grid Margin="0,0,0,6">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="70" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<CheckBox Grid.Column="0" Margin="0,0,10,0" Content="Cận" IsChecked="{Binding NearbyEnabled}" />
				<TextBox
					Grid.Column="2"
					Margin="0,0,6,0"
					Style="{StaticResource NumericTextBox}"
					Text="{Binding NearbyDelaySeconds, UpdateSourceTrigger=LostFocus}"
					controls:NumericInputBehavior.IsEnabled="True" />
				<TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="giây" />
			</Grid>
			<Grid Margin="0,0,0,6">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="70" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<CheckBox Grid.Column="0" Margin="0,0,10,0" Content="Khu vực" IsChecked="{Binding AreaEnabled}" />
				<TextBox
					Grid.Column="2"
					Margin="0,0,6,0"
					Style="{StaticResource NumericTextBox}"
					Text="{Binding AreaDelaySeconds, UpdateSourceTrigger=LostFocus}"
					controls:NumericInputBehavior.IsEnabled="True" />
				<TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="giây" />
			</Grid>
			<Grid Margin="0,0,0,6">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="70" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<CheckBox Grid.Column="0" Margin="0,0,10,0" Content="Giao" IsChecked="{Binding TradeEnabled}" />
				<TextBox
					Grid.Column="2"
					Margin="0,0,6,0"
					Style="{StaticResource NumericTextBox}"
					Text="{Binding TradeDelaySeconds, UpdateSourceTrigger=LostFocus}"
					controls:NumericInputBehavior.IsEnabled="True" />
				<TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="giây" />
			</Grid>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="70" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<CheckBox Grid.Column="0" Margin="0,0,10,0" Content="Lãnh địa" IsChecked="{Binding TerritoryEnabled}" />
				<TextBox
					Grid.Column="2"
					Margin="0,0,6,0"
					Style="{StaticResource NumericTextBox}"
					Text="{Binding TerritoryDelaySeconds, UpdateSourceTrigger=LostFocus}"
					controls:NumericInputBehavior.IsEnabled="True" />
				<TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="giây" />
			</Grid>
		</StackPanel>
	</Border>
</UserControl>
