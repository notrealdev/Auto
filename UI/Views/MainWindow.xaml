<Window
	x:Class="Auto.UI.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:views="clr-namespace:Auto.UI.Views"
	xmlns:vm="clr-namespace:Auto.UI.ViewModels"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	xmlns:app="clr-namespace:Auto"
	Title="{x:Static app:AppVersion.Title}"
	Icon="/app.ico"
	Width="420"
	Height="900"
	MinWidth="420"
	MinHeight="900"
	Background="{StaticResource Brush.Background}"
	WindowStyle="None"
	AllowsTransparency="False"
	ResizeMode="CanResize"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	RenderOptions.EdgeMode="Aliased"
	d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
	mc:Ignorable="d">

	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="5"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>

	<Window.Resources>
		<DataTemplate DataType="{x:Type vm:BasicViewModel}">
			<views:BasicView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:AttackViewModel}">
			<views:AttackView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:LootViewModel}">
			<views:LootView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:QuestViewModel}">
			<views:QuestView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:SupportViewModel}">
			<views:SupportView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:MarketViewModel}">
			<views:MarketView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:InfoViewModel}">
			<views:InfoView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:LoginViewModel}">
			<views:LoginView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:DebugViewModel}">
			<views:DebugView />
		</DataTemplate>
		<DataTemplate x:Key="AccountRowTemplate" DataType="{x:Type vm:AccountRowViewModel}">
			<StackPanel>
				<!--
					Đặt ContextMenu ở ĐÂY chứ không ở ItemContainerStyle: MenuItem thừa kế DataContext là chính
					AccountRowViewModel của dòng bị bấm, nên lệnh đóng luôn tác động đúng dòng đó kể cả khi nó
					chưa được chọn — chuột phải trong WPF không tự chọn ListBoxItem.
				-->
				<StackPanel.ContextMenu>
					<ContextMenu Style="{StaticResource DarkContextMenu}">
						<MenuItem
							Click="CloseGameProcess_Click"
							Header="Đóng cửa sổ game này"
							Style="{StaticResource DarkMenuItem}" />
					</ContextMenu>
				</StackPanel.ContextMenu>
				<Border x:Name="Separator" Height="1" Margin="0,0,0,4" Background="{StaticResource Brush.Border}" Opacity="0.4" />
				<!--
					Background="Transparent" là BẮT BUỘC để bấm được vào khoảng trống giữa hai cột: Grid không có
					Background thì WPF không hit-test vùng rỗng, click chỉ ăn khi trúng đúng chữ.
				-->
				<Grid
					Margin="0,0,0,4"
					Background="Transparent"
					MouseLeftButtonDown="AccountRow_Clicked">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="3*" />
						<ColumnDefinition Width="1*" />
					</Grid.ColumnDefinitions>
					<!--
						Click vào CheckBox thì WPF đánh dấu sự kiện chuột đã xử lý, nên ListBoxItem chứa nó KHÔNG
						được chọn. Hậu quả: bật Auto cho account này nhưng các tab bên dưới vẫn là cấu hình của
						account được chọn trước đó, tick nhầm account mà nhìn màn hình không thấy sai chỗ nào.
						Handler bên dưới chọn luôn dòng vừa bấm.
					-->
					<CheckBox
						Grid.Column="0"
						Margin="{StaticResource Size.CheckboxLabelGap}"
						Checked="AccountAutoEnabled_Toggled"
						IsChecked="{Binding AutoEnabled}"
						Unchecked="AccountAutoEnabled_Toggled" />
					<TextBlock
						Grid.Column="1"
						VerticalAlignment="Center"
						Foreground="{StaticResource Brush.TextPrimary}"
						Text="{Binding DisplayName}"
						TextTrimming="CharacterEllipsis" />
					<TextBlock
						Grid.Column="2"
						VerticalAlignment="Center"
						Foreground="{StaticResource Brush.TextSecondary}"
						Text="{Binding Vitals}"
						TextTrimming="CharacterEllipsis" />
				</Grid>
			</StackPanel>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="0">
					<Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>
	</Window.Resources>

	<Grid Background="{StaticResource Brush.Background}">
		<Grid.RowDefinitions>
			<RowDefinition Height="32" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border
			Grid.Row="0"
			Background="{StaticResource Brush.TitleBar}"
			MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Image
					Grid.Column="0"
					Width="16"
					Height="16"
					Margin="10,0,0,0"
					VerticalAlignment="Center"
					Source="/app.ico" />

				<TextBlock
					Grid.Column="1"
					Margin="8,0"
					VerticalAlignment="Center"
					Foreground="{StaticResource Brush.TextPrimary}"
					Text="{x:Static app:AppVersion.Title}" />

				<StackPanel Grid.Column="2" Orientation="Horizontal">
					<Button Click="Minimize_Click" Content="—" Style="{StaticResource TitleBarButton}" />
					<Button Click="Maximize_Click" Content="☐" Style="{StaticResource TitleBarButton}" />
					<Button Click="Close_Click" Content="✕" Style="{StaticResource TitleBarCloseButton}" />
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="1" Margin="{StaticResource Size.WindowGutter}" Background="{StaticResource Brush.Background}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<!-- Padding riêng cho block account, không dùng Size.CardPadding chung: đè trực tiếp ở đây, muốn chỉnh chỉ sửa số "12". -->
			<Border Grid.Row="0" Padding="12" Style="{StaticResource CardBorder}">
				<ListBox
					MaxHeight="200"
					AlternationCount="1000"
					Background="Transparent"
					BorderThickness="0"
					ItemContainerStyle="{StaticResource AccountListBoxItem}"
					ItemTemplate="{StaticResource AccountRowTemplate}"
					ItemsSource="{Binding AccountList.Accounts}"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					SelectedItem="{Binding AccountList.SelectedRow, Mode=TwoWay}" />
			</Border>

			<Grid Grid.Row="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<Border
					Grid.Row="0"
					Padding="0"
					Style="{StaticResource CardBorder}"
					BorderThickness="0">
					<ItemsControl ItemsSource="{Binding Tabs}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<!-- WPF không có "gap" như CSS flex/grid. TabRadioButton tự mang Margin="0,0,6,6" để
								     tạo khoảng cách phải/dưới giữa các nút; nhưng nút cuối mỗi hàng/cột vẫn giữ margin
								     đó, cộng dồn thành khoảng trống thừa ở mép phải và mép dưới của cả khối. Bù lại
								     đúng bằng Margin âm trên WrapPanel để mép ngoài luôn khít, còn khoảng cách GIỮA
								     các nút thì không đổi. -->
								<WrapPanel Margin="0,0,-6,-6" Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type vm:TabItemViewModel}">
								<RadioButton
									Content="{Binding Title}"
									GroupName="MainTabs"
									IsChecked="{Binding IsSelected, Mode=TwoWay}"
									Style="{StaticResource TabRadioButton}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>

				<ContentControl Grid.Row="1" Content="{Binding SelectedTabContent}" />
			</Grid>
		</Grid>

		<!--  Ô theo dõi vật phẩm nhặt được của MỌI account, gộp chung theo thứ tự thời gian.
		      Nguồn: LootFeed, nhận đúng những lượt nhặt vào loot-drops.log (nhãn LOOT_PICKED_UP), bỏ nhóm nhặt
		      thường xuyên đã tách sang loot-scan.log.
		      Dùng TextBox chỉ-đọc thay vì TextBlock để chủ dự án bôi đen copy được tên vật phẩm.  -->
		<Border
			Grid.Row="2"
			Margin="14,0,14,8"
			Padding="2"
			Background="{StaticResource Brush.Surface}"
			BorderBrush="{StaticResource Brush.Border}"
			BorderThickness="1"
			CornerRadius="4">
			<Grid>
				<!--
					VerticalContentAlignment="Top" là BẮT BUỘC ở đây: style TextBox chung (Styles.xaml) đặt "Center"
					và template của nó bind thẳng giá trị đó vào VerticalAlignment của PART_ContentHost, nên khi log
					còn ít dòng thì cả khối chữ bị dồn ra giữa ô.

					Padding phải bên phải để 28: chừa chỗ cho nút xoá nằm đè ở góc, khỏi bị chữ chạy xuống dưới nút.

					Text KHÔNG bind nữa mà do code-behind đẩy vào — xem LootFeed_Changed ở MainWindow.xaml.cs.
				-->
				<TextBox
					x:Name="LootFeedBox"
					Height="110"
					Padding="6,4,28,4"
					Background="Transparent"
					BorderThickness="0"
					FontFamily="Consolas"
					FontSize="11"
					Foreground="{StaticResource Brush.TextPrimary}"
					IsReadOnly="True"
					LostKeyboardFocus="LootFeed_LostKeyboardFocus"
					SelectionChanged="LootFeed_SelectionChanged"
					TextWrapping="NoWrap"
					VerticalContentAlignment="Top"
					VerticalScrollBarVisibility="Auto"
					HorizontalScrollBarVisibility="Auto" />
				<Button
					Margin="0,6,8,0"
					HorizontalAlignment="Right"
					VerticalAlignment="Top"
					Click="ClearLootFeed_Click"
					Style="{StaticResource OverlayIconButton}"
					ToolTip="Xoá ô theo dõi (không đụng tới loot-drops.log)">
					<Path
						Data="{StaticResource Icon.Trash}"
						Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
						StrokeEndLineCap="Round"
						StrokeStartLineCap="Round"
						StrokeThickness="1.2" />
				</Button>
			</Grid>
		</Border>

		<!--  Thanh trạng thái: tải của chính Auto. "Mức tải" là ước lượng của Auto theo %CPU, KHÔNG phải cột
		      Power usage của Windows (giá trị đó không có API công khai để đọc).  -->
		<Border
			Grid.Row="3"
			Margin="{StaticResource Size.StatusBarMargin}"
			Padding="10,6"
			Background="{StaticResource Brush.CheckboxChecked}"
			CornerRadius="4">
			<TextBlock
				FontSize="12"
				Foreground="{StaticResource Brush.TextPrimary}"
				Text="{Binding StatusBarText}" />
		</Border>
	</Grid>
</Window>
