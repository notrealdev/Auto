<Window
	x:Class="Auto.UI.Views.PotionNameDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Auto.UI.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:Auto.UI.ViewModels"
	Title="Cài đặt Dược Phẩm"
	Width="260"
	Height="340"
	d:DataContext="{d:DesignInstance Type=vm:PotionNameDialogViewModel}"
	Background="{StaticResource Brush.Background}"
	Foreground="{StaticResource Brush.TextPrimary}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ItemsControl Grid.Row="0" ItemsSource="{Binding PotionNames}">
			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="{x:Type vm:CheckableItemViewModel}">
					<CheckBox Margin="0,0,0,8" Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<StackPanel
			Grid.Row="1"
			Margin="0,4,0,12"
			Orientation="Horizontal">
			<TextBlock Style="{StaticResource FieldLabel}" Text="Không nhặt khi vượt quá" />
			<!--
				PropertyChanged chứ không LostFocus như LootView: bấm thẳng "Đồng ý" ngay sau khi gõ thì
				TextBox chưa mất focus, dùng LostFocus sẽ mất luôn số vừa nhập.
			-->
			<TextBox
				Width="46"
				Style="{StaticResource NumericTextBox}"
				Text="{Binding QuantityLimit, UpdateSourceTrigger=PropertyChanged}"
				controls:NumericInputBehavior.IsEnabled="True" />
		</StackPanel>

		<StackPanel
			Grid.Row="2"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Width="72"
				Margin="0,0,8,0"
				Command="{Binding AcceptCommand}"
				Content="Đồng ý"
				Style="{StaticResource AccentButton}" />
			<Button
				Width="72"
				Command="{Binding CancelCommand}"
				Content="Hủy" />
		</StackPanel>
	</Grid>
</Window>
