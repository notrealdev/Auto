<UserControl
	x:Class="Auto.UI.Views.LoginView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:Auto.UI.ViewModels"
	d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
	mc:Ignorable="d">

	<!--
		Tài khoản và mật khẩu nằm ngoài chương trình, trong Login\Login.json, nên tab này chỉ đọc và chọn.
		Ô tick khớp cột Checked của AutoFS (StoreOptions.cs:54).
	-->
	<UserControl.Resources>
		<!--  Chép đúng khuôn AccountRowTemplate của MainWindow.xaml:64-104 để hai danh sách nhìn giống nhau.  -->
		<DataTemplate x:Key="LoginAccountRowTemplate" DataType="{x:Type vm:LoginAccountRowViewModel}">
			<StackPanel>
				<Border x:Name="Separator" Height="1" Margin="0,0,0,4" Background="{StaticResource Brush.Border}" Opacity="0.4" />
				<Grid Margin="0,0,0,4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="3*" />
						<ColumnDefinition Width="1*" />
					</Grid.ColumnDefinitions>
					<CheckBox
						Grid.Column="0"
						Margin="{StaticResource Size.CheckboxLabelGap}"
						IsChecked="{Binding IsChecked}" />
					<TextBlock
						Grid.Column="1"
						VerticalAlignment="Center"
						Foreground="{StaticResource Brush.TextPrimary}"
						Text="{Binding MaskedUser}"
						TextTrimming="CharacterEllipsis" />
					<TextBlock
						Grid.Column="2"
						VerticalAlignment="Center"
						Foreground="{StaticResource Brush.TextSecondary}"
						Text="{Binding Partition}"
						TextTrimming="CharacterEllipsis" />
				</Grid>
			</StackPanel>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="0">
					<Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>
	</UserControl.Resources>

	<Border Style="{StaticResource CardBorder}">
		<StackPanel>
			<Grid Margin="0,0,0,10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBox
					Grid.Column="0"
					Margin="0,0,8,0"
					IsReadOnly="True"
					Style="{StaticResource NumericTextBox}"
					Text="{Binding GamePath, Mode=OneWay}"
					TextAlignment="Left" />
				<Button
					Grid.Column="1"
					Padding="10,4"
					Command="{Binding BrowseGamePathCommand}"
					Content="Chọn đường dẫn game" />
			</Grid>

			<ListBox
				MaxHeight="150"
				Margin="0,0,0,10"
				AlternationCount="1000"
				Background="Transparent"
				BorderThickness="0"
				ItemContainerStyle="{StaticResource AccountListBoxItem}"
				ItemTemplate="{StaticResource LoginAccountRowTemplate}"
				ItemsSource="{Binding Accounts}"
				ScrollViewer.HorizontalScrollBarVisibility="Disabled"
				ScrollViewer.VerticalScrollBarVisibility="Auto" />

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Button
					Grid.Column="0"
					Margin="0,0,8,0"
					Padding="10,4"
					Command="{Binding RunCommand}"
					Content="Đăng nhập" />
				<Button
					Grid.Column="1"
					Padding="10,4"
					Command="{Binding StopCommand}"
					Content="Dừng" />
			</Grid>
		</StackPanel>
	</Border>
</UserControl>
